# ==============================================================================
# InstituteOS Environment Configuration
# ==============================================================================

# Supabase Credentials (from https://supabase.com -> Project Settings -> API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side audited operations only. Never expose this key to browser code or any VITE_ variable.
SUPABASE_SERVICE_ROLE_KEY=

# Operations Copilot. These values are server-only; never prefix them with VITE_.
ANTHROPIC_API_KEY=
COPILOT_PROVIDER=anthropic
COPILOT_MODEL=claude-sonnet-5
COPILOT_ENABLED=true
COPILOT_DAILY_TOKEN_CAP_PER_INSTITUTE=100000
# Test-only: set to 1 with ANTHROPIC_API_KEY to opt into the live provider smoke test.
COPILOT_LIVE_EVAL=0

PORT=5000
