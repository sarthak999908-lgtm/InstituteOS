# ==============================================================================
# InstituteOS Environment Configuration
# ==============================================================================

# Supabase Credentials (from https://supabase.com -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: Server-side Service Role Key for Admin operations
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Copilot Execution Mode ('local' or 'remote')
VITE_COPILOT_MODE=local
VITE_COPILOT_ENDPOINT=http://localhost:5000/api
PORT=5000